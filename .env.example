# Build-a-bot environment. Copy to .env.local for development.
# Nothing here is required to try it locally: without keys the app runs in demo
# mode (simulated brain, apps and channels). Never commit real values.

# ── Core ─────────────────────────────────────────────────────────────────────
# Public URL of the app (webhooks, OAuth callbacks, links in emails).
APP_URL=http://localhost:3000
# 1 = simulate anything that isn't configured. Defaults to on outside production.
# DEMO_MODE=1
# Postgres (Supabase, Neon, RDS...). Unset = embedded PGlite under DATA_DIR.
# DATABASE_URL=postgres://user:pass@host:5432/db
# DATABASE_POOL_MAX=5
# AUTO_MIGRATE=1
# DATA_DIR=.data/pglite
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts API keys and
# tokens at rest. Required in production; never change it once data exists.
# ENCRYPTION_KEY=
# Shared secret for /api/cron/tick (Vercel Cron sends it as a Bearer token).
# CRON_SECRET=
# Set to 1 to stop the in-process scheduler (when an external cron calls /api/cron/tick).
# DISABLE_INTERNAL_CRON=1
# Shown on legal and safety pages.
# NEXT_PUBLIC_SUPPORT_EMAIL=
# How owners start the Bridge (subscription brains). Default: the site serves its own copy,
# `npx -y {APP_URL}/downloads/build-a-bot-bridge-<version>.tgz`; on localhost,
# `node bridge/bab-bridge.mjs` from this repo. Set this only to override both.
# BRIDGE_CLI=node bridge/bab-bridge.mjs
# Site-wide daily ceilings on what costs money (anyone can sign up, accounts are free):
# included-brain turns, paid web lookups and voice typing dictations per UTC day.
# 0 turns a ceiling off.
# INCLUDED_DAILY_LIMIT=3000
# SEARCH_DAILY_LIMIT=300
# DICTATION_DAILY_LIMIT=20000
# Who can open /admin (operator metrics), comma-separated verified emails.
# In demo mode without it, any signed-in user can look.
# ADMIN_EMAILS=you@your-domain.example
# Demo servers show sign-in links on screen, so admin emails also need this code there
# (a long passphrase only you know). Not needed once real email is set up.
# ADMIN_SIGNIN_CODE=

# ── Included brain: open models on Nebius Token Factory ─────────────────────
TOKEN_FACTORY_API_KEY=
# TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Optional model id overrides (when Token Factory renames a model):
# TF_MODEL_LIGHTNING=nvidia/Nemotron-3_5-Lightning
# TF_MODEL_QWEN_FAST=Qwen/Qwen3-30B-A3B-Instruct-2507
# TF_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# TF_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# ── Tools ────────────────────────────────────────────────────────────────────
# Web search and reading (Tavily: 1,000 free credits a month).
TAVILY_API_KEY=
# Composio: managed sign-in and tools for hundreds of apps.
# COMPOSIO_API_KEY=
# COMPOSIO_BASE_URL=https://backend.composio.dev
# Per-toolkit overrides: COMPOSIO_AUTH_CONFIG_GMAIL=ac_..., COMPOSIO_TOOLKIT_VERSION_GMAIL=...
# Pre-registered OAuth clients for MCP servers that don't allow self-registration,
# keyed by issuer URL or host: {"mcp.example.com":{"client_id":"...","client_secret":"..."}}
# MCP_OAUTH_CLIENTS=

# ── Channels ─────────────────────────────────────────────────────────────────
# Telegram managed bots: your manager bot (BotFather → Bot Settings → Bot Management).
# TELEGRAM_MANAGER_BOT_TOKEN=
# TELEGRAM_MANAGER_BOT_USERNAME=
# Required with a manager bot: the webhook refuses every update without it.
# TELEGRAM_MANAGER_WEBHOOK_SECRET=
# Twilio: texts and phone calls (US & Canada number).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+15555550100
# TWILIO_VOICE=Polly.Joanna-Neural
# Email: AgentMail (inboxes per bot) or Resend (inbound routes). Bots get
# addresses on BOT_EMAIL_DOMAIN, which must never contain the product name.
# Bots' email needs the domain plus one provider's key and webhook secret; a
# Resend key on its own only sends sign-in links.
# AGENTMAIL_API_KEY=
# AGENTMAIL_WEBHOOK_SECRET=
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# BOT_EMAIL_DOMAIN=
# EMAIL_FROM="Build-a-bot <hello@your-domain.example>"
# EMAIL_INBOUND_SECRET=
# Slack's shared "Add to Slack" app (one click; see docs/DEPLOY.md §5 and docs/slack-app-manifest.json).
# Without these, owners make their bot its own Slack app from a manifest instead.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# Discord (interactions endpoint: {APP_URL}/api/webhooks/discord; then `npm run discord:register`).
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_BOT_TOKEN=

# ── Billing ──────────────────────────────────────────────────────────────────
# Without Stripe, Plus and Pro say "Coming soon" (with a waitlist) outside demo mode;
# demo mode switches plans without paying.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PLUS_MONTHLY=price_...
# STRIPE_PRICE_PLUS_YEARLY=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...

# ── Speech: meeting notes and voice typing ──────────────────────────────────
# Speech-to-text on any OpenAI-compatible /audio/transcriptions endpoint.
# Nebius Token Factory has no speech-to-text model. The default is Groq's Whisper
# large-v3 turbo (~$0.04/audio hour; use the paid tier: the free tier allows only
# 7,200 audio-seconds an hour). Providers: groq | together | openai | custom (set the base URL).
# Without a key, demo mode plays a scripted meeting and "hears" sample dictations;
# production says "coming soon". Turn on Zero Data Retention in Groq's console (Data controls).
# TRANSCRIBE_PROVIDER=groq
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=whisper-large-v3-turbo
# TRANSCRIBE_BASE_URL=
# Used automatically when the main provider is rate-limited or down (Together AI, ~$0.09/hour).
# TRANSCRIBE_FALLBACK_PROVIDER=together
# TRANSCRIBE_FALLBACK_API_KEY=
# TRANSCRIBE_FALLBACK_MODEL=openai/whisper-large-v3
# Voice typing's AI cleanup (ums out, punctuation, corrections kept): groq | included | off.
# Unset: Groq with the key above when speech-to-text runs on Groq (so the words go to one
# provider), else the included model on Token Factory. Without either, only the plain cleanup.
# DICTATION_POLISH=
# DICTATION_POLISH_MODEL=openai/gpt-oss-120b
# Where people download the desktop app for meeting notes and voice typing (desktop/): a page
# or file with the signed Mac and Windows builds. Unset = the app shows it as "Coming soon" (demo
# mode shows how to run it from the repo instead). Set it once signed downloads are published.
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=https://your-domain.example/download

# ── Web actions (beta): a cloud browser that reads sites and fills out forms ──
# Browser Use Cloud (cloud.browser-use.com → Settings → API keys). Forms are filled
# but never sent until the owner approves a preview; no payments, logins or passwords.
# Without a key, demo mode simulates the browser; production shows "not set up".
# BROWSER_USE_API_KEY=
# BROWSER_USE_BASE_URL=https://api.browser-use.com/api/v2
# Agent model (Browser Use's `llm`); unset = their default (browser-use-2.0).
# BROWSER_USE_MODEL=
# Proxy country for the cloud browser (us, de...; "off" = none). Unset = US.
# BROWSER_USE_PROXY_COUNTRY=
