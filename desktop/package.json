{
  "name": "build-a-bot-desktop",
  "productName": "Build-a-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Build-a-bot for your computer: your bot notices when a call starts, asks before it takes notes, and stays visible at the bottom of your screen the whole time it listens.",
  "main": "src/main/main.mjs",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --server=http://localhost:3000",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "xvfb-run -a --server-args=\"-screen 0 1440x900x24\" node --test --test-timeout=300000 \"e2e/*.e2e.mjs\"",
    "icons": "node scripts/render-icons.mjs",
    "build:mac-helper": "bash native/macos/build.sh",
    "dist": "npx --yes electron-builder@26 --config electron-builder.yml"
  },
  "devDependencies": {
    "electron": "44.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
