{
  "name": "build-a-bot-desktop",
  "productName": "Build-a-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Build-a-bot for your computer: your bots take notes in your calls (asking first, and always showing they're listening) and type what you say.",
  "main": "src/main/main.mjs",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --server=http://localhost:3000",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "xvfb-run -a --server-args=\"-screen 0 1440x900x24\" node --test --test-concurrency=1 --test-timeout=300000 \"e2e/*.e2e.mjs\"",
    "icons": "node scripts/render-icons.mjs",
    "build:mac-helper": "bash native/macos/build.sh",
    "dist": "npx --yes electron-builder@26.15.3 --config electron-builder.yml"
  },
  "devDependencies": {
    "electron": "44.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "electron-updater": "6.8.10",
    "uiohook-napi": "1.5.5"
  }
}
