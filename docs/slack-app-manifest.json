{
  "display_information": {
    "name": "Build-a-bot",
    "description": "Your own AI assistant, in your Slack DMs.",
    "background_color": "#2a1b75"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Build-a-bot",
      "always_online": true
    }
  },
  "oauth_config": {
    "redirect_urls": ["https://build-a-bot.site/api/channels/slack/callback"],
    "scopes": {
      "bot": ["chat:write", "chat:write.customize", "im:history", "im:write"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://build-a-bot.site/api/webhooks/slack/events",
      "bot_events": ["app_uninstalled", "message.im", "tokens_revoked"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://build-a-bot.site/api/webhooks/slack/interactive"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
